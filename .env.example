# The production frontend's contract address, chain ID, and RPC URL are
# intentionally hardcoded in apps/web/src/contract.ts per release, not read
# from any VITE_* environment variable (an unused VITE_PROOFRAIL_CONTRACT_ADDRESS
# here would look like a working override but be silently ignored, which is
# exactly the ambiguity this comment exists to rule out). To point the local
# dev build at a different deployment, edit the CONTRACT constant in
# apps/web/src/contract.ts directly, next to the comment explaining the
# current and retired release addresses.
PROOFRAIL_DEPLOYER_KEY=
PROOFRAIL_ISSUER_KEY=
PROOFRAIL_RECIPIENT_KEY=
PROOFRAIL_CONTRACT_ADDRESS=
PROOFRAIL_RELEASE_ID=
PROOFRAIL_PUBLISHER_DOMAINS=publisher-1.example,publisher-2.example,publisher-3.example,publisher-4.example,publisher-5.example
PROOFRAIL_DRY_RUN=1
